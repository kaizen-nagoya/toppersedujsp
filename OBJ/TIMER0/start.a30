PRCR		.EQU		000AH		; プロテクトレジスタ
PRC0		.BTEQU		0,PRCR		; システムクロックレジスタビット
PRC1		.BTEQU		1,PRCR		; プロセッサモードレジスタビット
;
PM0		.EQU		0004H		; プロセッサモードレジスタ０
PM1		.EQU		0005H		; プロセッサモードレジスタ１
;
CM0		.EQU		0006H		; クロックモードレジスタ０
CM1		.EQU		0007H		; クロックモードレジスタ１
C_CM0		.EQU	00001000B		; CM0(Xcin-HIGH)
C_CM1		.EQU	00100000B		; CM1(Xin-HIGH)

;/*	定数定義（初期化）*/
;
RAMEND_ADR	.EQU	000C00h
VECTOR_ADR 	.EQU	0FA000h					; ベクタアドレス

	.glb	_serial_in_handler1_entry
	.glb	_serial_in_handler2_entry
	.glb	_timer_handler_entry
	.glb	_irregular_int_handler_entry
	.glb	_irregular_ext_handler_entry
;
;************************************************
;* interrupt vectors                            *
;************************************************
;
	.section	vector
	.org	VECTOR_ADR
;
	.lword	_irregular_int_handler_entry	; 00
	.org	(VECTOR_ADR+44)

	.lword	_irregular_int_handler_entry	; 11
	.lword	_irregular_int_handler_entry	; 12
	.lword	_irregular_int_handler_entry	; 13
	.lword	_irregular_int_handler_entry	; 14
	.org	(VECTOR_ADR+68)

	.lword	_irregular_int_handler_entry	; 17
	.lword	_irregular_int_handler_entry	; 18
	.lword	_irregular_int_handler_entry	; 19
	.lword	_irregular_int_handler_entry	; 20
	.lword	_timer_handler_entry		; 21
	.lword	_irregular_int_handler_entry	; 22
	.lword	_irregular_int_handler_entry	; 23
	.lword	_irregular_int_handler_entry	; 24
	.lword	_irregular_int_handler_entry	; 25
	.lword	_irregular_int_handler_entry	; 26
	.lword	_irregular_int_handler_entry	; 27
	.lword	_irregular_int_handler_entry	; 28
	.lword	_irregular_int_handler_entry	; 29
	.lword	_irregular_int_handler_entry	; 30
	.lword	_irregular_int_handler_entry	; 31
	.lword	_irregular_int_handler_entry	; 32
	.lword	_irregular_int_handler_entry	; 33
	.lword	_irregular_int_handler_entry	; 34
	.lword	_irregular_int_handler_entry	; 35
	.lword	_irregular_int_handler_entry	; 36
	.lword	_irregular_int_handler_entry	; 37
	.lword	_irregular_int_handler_entry	; 38
	.lword	_irregular_int_handler_entry	; 39
	.lword	_irregular_int_handler_entry	; 40
	.lword	_irregular_int_handler_entry	; 41
	.lword	_irregular_int_handler_entry	; 42
	.lword	_irregular_int_handler_entry	; 43
	.lword	_irregular_int_handler_entry	; 44
	.lword	_irregular_int_handler_entry	; 45
	.lword	_irregular_int_handler_entry	; 46
	.lword	_irregular_int_handler_entry	; 47
;
;************************************************
;* interrupt vectors                            *
;************************************************
;
	.section	fvector
	.org	0fffdch
	.lword	_irregular_ext_handler_entry	; 00
	.lword	_irregular_ext_handler_entry	; 01
	.lword	_irregular_ext_handler_entry	; 02
	.lword	_irregular_ext_handler_entry	; 03
	.lword	_irregular_ext_handler_entry	; 04
	.lword	_irregular_ext_handler_entry	; 05
	.lword	_irregular_ext_handler_entry	; 06
	.lword	_irregular_ext_handler_entry	; 07
	.lword	start			; RESET
;
;
;************************************************
;*	RAM領域の設定				*
;************************************************
	.section	bss_NE,DATA
;
;************************************************
;*	初期化ルーチン				*
;************************************************
	.section	program
	.glb	start
;
start:
	LDC		#0a50h,ISP		; 割り込みスタックポインタセット
; ----- set Processor mode -----
	BSET		PRC1			; プロセッサモードレジスタ書き込みイネーブル
	MOV.B		#00000000b,PM0		; シングルチップモード
	MOV.B		#00000000b,PM1		; 非拡張、ノーウェイト
	BCLR		PRC1			; プロセッサモードレジスタ書き込みディゼーブル
; ----- set System clock -----
	BSET		PRC0			; クロックコントロールレジスタ書き込みイネーブル
	MOV.B		#C_CM0,CM0		; 発信
	MOV.B		#C_CM1,CM1		; 分周なし
	BCLR		PRC0			; レジスタ書き込みディゼーブル
;
	fclr	i				; 割り込み禁止
	ldintb	#VECTOR_ADR			; ベクタテーブルの設定
;
;	***** メインルーチンへ	*****
	.glb	_main
	jsr.a	_main				; --> main()
;
;************************************************
;*	ダミープログラム			*
;************************************************
	.glb	_irregular_int_handler_entry
	.glb	_irregular_ext_handler_entry
_irregular_int_handler_entry:
_irregular_ext_handler_entry:
	reit

	.end
